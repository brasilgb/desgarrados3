# Local, non-production MariaDB/MySQL configuration. Copy values into .env only
# after creating an empty database and a least-privilege local database user.
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=desgarrados_local
DB_USERNAME=desgarrados_local
DB_PASSWORD=replace-with-local-password

# Keep session, cache, and queue on the database-backed configuration from .env.
